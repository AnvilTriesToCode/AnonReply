# ==============================================================================
# AnonReply — Production Environment File (.env.production.example)
# ==============================================================================
# Rename this file to .env.production or .env on your server

# MongoDB database connection
MONGODB_URI=mongodb://mongodb:27017/anonreply

# NextAuth secret key (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=change-this-to-a-secure-32-character-random-string

# Public website URL (must match your custom domain)
NEXTAUTH_URL=https://yourdomain.com

# Admin initial credentials
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@yourdomain.com
NOTIFICATION_ROUTING_EMAIL=notifications@yourdomain.com

# Email notifications (Resend API)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
