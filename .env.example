# ==============================================================================
# AnonReply — Self-Hosted Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Connection
# ------------------------------------------------------------------------------
# If running via Docker Compose, use:
MONGODB_URI=mongodb://mongodb:27017/anonreply
# If running on local server directly, use:
# MONGODB_URI=mongodb://127.0.0.1:27017/anonreply

# ------------------------------------------------------------------------------
# 2. NextAuth Configuration
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secure-32-character-secret-key-here
# Your public custom domain (with https://)
NEXTAUTH_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# 3. Administrator Team Configuration
# ------------------------------------------------------------------------------
# Initial password for all 5 default umbrella admin seats (admin, moderator1, etc.)
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@yourdomain.com
NOTIFICATION_ROUTING_EMAIL=notifications@yourdomain.com

# ------------------------------------------------------------------------------
# 4. Email Delivery via Resend (Optional)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# 5. Google OAuth Authentication (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
